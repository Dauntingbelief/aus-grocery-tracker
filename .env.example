# Copy to .env and fill in. Never commit .env.
# AWS credentials are NOT stored here: sign in with `aws login --profile grocery-tracker` (short-lived credentials).

# Named AWS CLI profile to deploy and run with (milestone 3)
AWS_PROFILE=grocery-tracker
# Sydney region keeps data in Australia
AWS_REGION=ap-southeast-2

# Email address for the AWS Budgets $5 alert (milestone 3)
BUDGET_ALERT_EMAIL=you@example.com

# ABS Data API (public, no key needed)
ABS_API_BASE=https://data.api.abs.gov.au/rest
